<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lidar_robot">

  <!-- measured values -->
  <xacro:property name="wheel_sep" value="0.175"/>
  <xacro:property name="wheel_radius" value="0.03"/>
  <xacro:property name="lidar_x" value="-0.08"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_height_above_ground" value="0.22"/>

  <!-- estimated values (replace after measuring) -->
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="body_mass" value="1.2"/>

  <xacro:property name="plate_cx" value="-0.08"/>
  <xacro:property name="bottom_length" value="0.22"/>
  <xacro:property name="bottom_width" value="0.14"/>
  <xacro:property name="bottom_z" value="0.0"/>
  <xacro:property name="plate_thick" value="0.004"/>

  <xacro:property name="mid_radius" value="0.08"/>
  <xacro:property name="mid_z" value="0.075"/>
  <xacro:property name="top_radius" value="0.065"/>
  <xacro:property name="top_z" value="0.15"/>
  <xacro:property name="standoff_len" value="0.15"/>

  <xacro:property name="bank_x" value="-0.10"/>
  <xacro:property name="lipo_x" value="-0.09"/>

  <xacro:property name="caster_radius" value="0.015"/>
  <xacro:property name="caster_x" value="-0.17"/>

  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>

  <material name="wood"><color rgba="0.78 0.62 0.40 1"/></material>
  <material name="clear"><color rgba="0.75 0.88 1.0 0.4"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="gold"><color rgba="0.85 0.65 0.13 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
  <material name="blue"><color rgba="0.1 0.5 0.85 1"/></material>

  <xacro:macro name="standoff" params="x y">
    <visual>
      <origin xyz="${x} ${y} ${standoff_len/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="${standoff_len}"/></geometry>
      <material name="gold"/>
    </visual>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">

    <!-- bottom plate -->
    <visual>
      <origin xyz="${plate_cx} 0 ${bottom_z}" rpy="0 0 0"/>
      <geometry><box size="${bottom_length} ${bottom_width} ${plate_thick}"/></geometry>
      <material name="wood"/>
    </visual>

    <!-- power bank on bottom plate -->
    <visual>
      <origin xyz="${bank_x} 0 0.012" rpy="0 0 0"/>
      <geometry><box size="0.15 0.07 0.018"/></geometry>
      <material name="black"/>
    </visual>

    <!-- standoffs -->
    <xacro:standoff x="${plate_cx + 0.06}" y="0.05"/>
    <xacro:standoff x="${plate_cx + 0.06}" y="-0.05"/>
    <xacro:standoff x="${plate_cx - 0.06}" y="0.05"/>
    <xacro:standoff x="${plate_cx - 0.06}" y="-0.05"/>

    <!-- middle round clear plate -->
    <visual>
      <origin xyz="${plate_cx} 0 ${mid_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${mid_radius}" length="${plate_thick}"/></geometry>
      <material name="clear"/>
    </visual>

    <!-- battery on middle plate -->
    <visual>
      <origin xyz="${lipo_x} 0 ${mid_z + 0.012}" rpy="0 0 0"/>
      <geometry><box size="0.07 0.035 0.02"/></geometry>
      <material name="dark"/>
    </visual>

    <!-- top plate (lidar mount) -->
    <visual>
      <origin xyz="${plate_cx} 0 ${top_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${top_radius}" length="${plate_thick}"/></geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="${plate_cx} 0 ${bottom_z}" rpy="0 0 0"/>
      <geometry><box size="${bottom_length} ${bottom_width} ${plate_thick}"/></geometry>
    </collision>

    <inertial>
      <origin xyz="${plate_cx} 0 0.03" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia
        ixx="${body_mass/12*(bottom_width*bottom_width + 0.02)}" ixy="0" ixz="0"
        iyy="${body_mass/12*(bottom_length*bottom_length + 0.02)}" iyz="0"
        izz="${body_mass/12*(bottom_length*bottom_length + bottom_width*bottom_width)}"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name y s">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin xyz="0 ${s*0.0135} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius*0.65}" length="0.002"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0" ixz="0"
          iyy="${wheel_mass*wheel_radius*wheel_radius/2}" iyz="0"
          izz="${wheel_mass/12*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left" y="${wheel_sep/2}" s="1"/>
  <xacro:wheel name="right" y="${-wheel_sep/2}" s="-1"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.17"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_height_above_ground - wheel_radius}" rpy="0 0 ${pi}"/>
  </joint>

</robot>